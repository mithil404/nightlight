# Copy to .env (`pnpm bootstrap` does this for you). Never commit .env.

# AWS profile from your ~/.aws/config (standard profile chain). Leave empty to use the default profile.
AWS_PROFILE=

# AWS region for every Nightlight resource. Bedrock model IDs and Polly voices
# are configured in packages/shared/src/models.ts.
AWS_REGION=us-east-1

# Stack name suffix -> Nightlight-<STAGE>. Defaults to your OS username (cleaned up)
# so teammates' deploys don't collide.
STAGE=
