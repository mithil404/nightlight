{
  "name": "nightlight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.ts",
    "preflight": "node scripts/preflight.ts",
    "tv:sim": "node scripts/tv.ts sim",
    "tv:device": "node scripts/tv.ts device",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "tsc -p scripts && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test:ci",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.8.3"
  }
}
