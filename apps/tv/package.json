{
  "name": "@nightlight/tv",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "jest --colors ",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src test package.json --ext .ts,.tsx",
    "lint:fix": "eslint src test package.json --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "typecheck": "tsc --noEmit -p .",
    "test:ci": "jest --ci"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "4.0.1",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "0.22.14",
    "@amazon-devices/eslint-plugin-kepler": "0.1.15",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "babel-jest": "29.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-jest": "27.9.0",
    "jest": "29.7.0",
    "jsonc-eslint-parser": "2.4.2",
    "npm-run-all": "4.1.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "29.4.14",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Nightlight",
    "targets": [
      "tv"
    ]
  }
}
